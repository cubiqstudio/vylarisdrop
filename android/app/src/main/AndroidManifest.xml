<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Benachrichtigungen (Downloads, Upload-Fortschritt, "Hochgeladen") ab Android 13 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Kamera/Mikrofon nur für die Aufnahme im Web (getUserMedia) und das Foto beim Datei-Hochladen; Abfrage erst bei Bedarf -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Upload beim Teilen läuft als Vordergrunddienst, damit er bei ausgeschaltetem Bildschirm weiterläuft -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VylarisCloud">

        <activity
            android:name=".HauptActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Einrichtung; auch Ziel des Links vylariscloud://koppeln?s=<Server>&c=<Code> -->
        <activity
            android:name=".EinrichtungActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="koppeln" android:scheme="vylariscloud" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EinstellungenActivity"
            android:exported="false" />

        <!-- "Teilen mit VylarisCloud": durchsichtig, startet nur den Upload-Dienst -->
        <activity
            android:name=".TeilenActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/teilen_label"
            android:taskAffinity=""
            android:theme="@style/Theme.VylarisCloud.Durchsichtig">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".UploadDienst"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".LinkReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
