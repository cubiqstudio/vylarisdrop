{
	on_demand_tls {
		ask http://app:3000/api/internal/caddy-ask
	}
}

:80 {
	encode gzip zstd
	reverse_proxy app:3000
}

https:// {
	tls {
		on_demand
	}
	encode gzip zstd
	reverse_proxy app:3000
}

